<%= form_with(model: @word, local: true, class: "word-form") do |form| %>
  <% if @word.errors.any? %>
    <div class="form-errors">
      <h4 class="form-errors-title">
        <%= pluralize(@word.errors.count, "lỗi") %> đã ngăn không cho từ này được lưu:
      </h4>
      <ul class="form-errors-list">
        <% @word.errors.full_messages.each do |message| %>
          <li class="form-errors-item"><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :content, "Nội dung", class: "form-label" %>
    <%= form.text_area :content,
          placeholder: "Nhập từ...",
          class: "form-input",
          rows: 3 %>
  </div>

  <div class="form-field">
    <%= form.label :word_type, "Loại từ", class: "form-label" %>
    <%= form.select :word_type,
          Word.word_types.map { |key, value| [key.humanize, key] },
          { prompt: "Chọn loại từ" },
          { class: "form-input" } %>
  </div>

  <div class="form-field">
    <%= form.label :meaning, "Ý nghĩa", class: "form-label" %>
    <%= form.text_area :meaning,
          placeholder: "Nhập ý nghĩa...",
          class: "form-input",
          rows: 3 %>
  </div>

  <div class="form-actions">
    <%= form.submit submit_text, class: "button button-primary" %>
    <% if show_cancel %>
      <%= link_to "Hủy", words_path, class: "button button-danger" %>
    <% end %>
  </div>
<% end %>
